# Backend runtime configuration
PROTOCOL=http
PORT=1337

# Exact browser origin of the Vue frontend (required for cross-origin cookie auth)
CORS_CLIENT_ORIGIN=http://localhost:8081

# MongoDB Atlas connection string, including the database name (e.g. Todo)
MONGODB_CONNECTION_STRING=

# Generate a long, random value; never commit the real secret
SESSION_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
